# Skopiuj do .env i uzupełnij: cp .env.example .env
# Katalog: docs/katalog_env.md

# HTTP (opcjonalne — domyślnie 5053)
SERV_PORT=5053

# JWT — podpis cookie SESSID (wymagane)
JWT_SECRET=change-me-to-a-long-random-string

# MySQL — szczegóły ops / compose (bez drugiego poola w kodzie)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=budget_user
DB_PASSWORD=budget_password
DB_NAME=home_budget

# Prisma Client + Migrate (wymagane w runtime po R6)
DATABASE_URL=mysql://budget_user:budget_password@127.0.0.1:3306/home_budget

# E-mail outbound (K-14) — opcjonalne; bez nich wysyłka jest no-op
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Home Budget Manager <noreply@example.com>"
# FRONTEND_ORIGIN=http://localhost:3000
