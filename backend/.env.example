# Skopiuj do .env i uzupełnij: cp .env.example .env
# Katalog: docs/katalog_env.md

# HTTP (opcjonalne — domyślnie 5053)
SERV_PORT=5053

# JWT — podpis cookie SESSID (wymagane)
JWT_SECRET=change-me-to-a-long-random-string

# MySQL — pool w database/db.js (wymagane)
DB_HOST=127.0.0.1
DB_USER=budget_user
DB_PASSWORD=budget_password
DB_NAME=home_budget
